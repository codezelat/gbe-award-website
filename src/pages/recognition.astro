---
import "../styles/global.css";
import ThemeInit from "../components/ThemeInit.astro";
import SeoHead from "../components/SeoHead.astro";
import Header from "../components/Header.astro";
import SiteFooter from "../components/SiteFooter.astro";
import RecognitionPartnerLogo from "../components/RecognitionPartnerLogo.astro";
import RecognitionRoleIcon from "../components/RecognitionRoleIcon.astro";
import { assetPaths } from "../data/home";
import { certificateAuthenticitySteps, recognitionPartners } from "../data/recognition";
import { buildBreadcrumbSchema, buildItemListSchema, buildPageSchema } from "../lib/seo";

export const prerender = true;

const title = "Recognition and Certificate Authenticity | GBE Awards 2026";
const description =
  "Understand the distinct roles of the Distance Education Council, SITC Campus Business Faculty, and London Business Consultancy in GBE Awards recognition, research, administration, and certificate authenticity.";
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInit />
    <SeoHead
      title={title}
      description={description}
      keywords="GBE Awards recognition, GBE Awards certificate authenticity, Distance Education Council Sri Lanka, SITC Campus Business Faculty, London Business Consultancy UK"
      path="/recognition"
      image={assetPaths.trophy}
      schema={[
        buildPageSchema({
          path: "/recognition",
          title,
          description,
          image: assetPaths.trophy,
        }),
        buildBreadcrumbSchema([
          { name: "Home", path: "/" },
          { name: "Recognition", path: "/recognition" },
        ]),
        buildItemListSchema({
          path: "/recognition",
          title: "GBE Awards recognition framework",
          items: recognitionPartners.map((partner) => ({
            name: partner.name,
            image: partner.key === "lbc" ? undefined : partner.logo,
            description: partner.summary,
          })),
        }),
      ]}
    />
  </head>
  <body>
    <div class="min-h-screen bg-[var(--c-page-glow)]">
      <Header />
      <main class="bg-gbe-bg pb-24 pt-[210px] max-[1024px]:pt-[160px] max-[560px]:pb-14 max-[560px]:pt-[130px]">
        <section class="container-gbe relative mb-20 max-w-[1120px] overflow-hidden max-[560px]:mb-14">
          <div class="mandala pointer-events-none absolute -right-36 -top-32 size-[470px] opacity-35" aria-hidden="true"></div>
          <div class="relative max-w-[940px]">
            <p class="mb-4 mt-0 text-xs font-black uppercase tracking-[0.22em] text-gbe-gold-soft">Recognition framework</p>
            <h1 class="gold-text mb-7 mt-0 text-[clamp(38px,5.4vw,70px)] font-black leading-[0.96] max-[560px]:text-[34px]">
              Recognition, research and certificate authenticity
            </h1>
            <p class="mb-0 max-w-[820px] text-[clamp(17px,1.45vw,21px)] font-normal leading-[1.72] text-gbe-muted">
              GBE Awards brings together three distinct responsibilities: institutional recognition in Sri Lanka,
              business-faculty research and academic review, and administration by a registered company in the
              United Kingdom. This page explains those roles without blurring the difference between them.
            </p>
          </div>
        </section>

        <section class="container-gbe mb-20 max-w-[1120px] max-[560px]:mb-14" aria-labelledby="roles-title">
          <div class="mb-8 grid grid-cols-[0.55fr_1fr] items-end gap-10 max-[760px]:grid-cols-1 max-[760px]:gap-5">
            <h2 id="roles-title" class="gold-text m-0 text-[clamp(29px,3vw,42px)] font-black leading-tight">Distinct roles, clearly stated</h2>
            <p class="m-0 text-[16px] font-normal leading-[1.7] text-gbe-muted">
              Recognition is strongest when the organisations involved and the limits of their responsibilities are easy to understand.
            </p>
          </div>

          <div class="border-t border-gbe-gold/25">
            {recognitionPartners.map((partner, index) => (
              <article class="grid grid-cols-[minmax(0,1fr)_260px] items-center gap-12 border-b border-gbe-gold/20 py-9 max-[760px]:grid-cols-1 max-[760px]:gap-6">
                <div class="flex gap-5 max-[560px]:gap-4">
                  <RecognitionRoleIcon type={partner.key} />
                  <div>
                    <p class="mb-1 mt-0 text-[11px] font-black uppercase tracking-[0.18em] text-gbe-gold-soft">{partner.eyebrow}</p>
                    <h3 class="mb-2 mt-0 text-[clamp(22px,2.4vw,31px)] font-black leading-tight text-gbe-text">{partner.name}</h3>
                    <p class="mb-3 mt-0 text-[16px] font-normal leading-[1.7] text-gbe-muted">{partner.summary}</p>
                    <p class="mb-5 mt-0 text-[15px] font-normal leading-[1.68] text-gbe-muted">{partner.detail}</p>
                    <a
                      class="text-sm font-black text-gbe-gold underline decoration-gbe-gold/45 underline-offset-4 transition-colors hover:text-gbe-gold-bright"
                      href={partner.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {partner.sourceLabel}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </div>
                </div>
                <RecognitionPartnerLogo partner={partner} maskId={`lbc-page-${index}-mask`} />
              </article>
            ))}
          </div>
        </section>

        <section
          id="certificate-authenticity"
          class="scroll-mt-[170px] border-y border-gbe-gold/15 bg-gbe-surface-2 py-20 max-[560px]:py-14"
          aria-labelledby="certificate-title"
        >
          <div class="container-gbe max-w-[1120px]">
            <div class="grid grid-cols-[0.75fr_1.25fr] gap-16 max-[900px]:grid-cols-1 max-[900px]:gap-10">
              <div>
                <p class="mb-3 mt-0 text-xs font-black uppercase tracking-[0.2em] text-gbe-gold-soft">Certificate authenticity</p>
                <h2 id="certificate-title" class="gold-text mb-5 mt-0 text-[clamp(31px,4vw,50px)] font-black leading-[1.02]">
                  A certificate connected to a real award record
                </h2>
                <p class="mb-5 mt-0 text-[16px] font-normal leading-[1.72] text-gbe-muted">
                  GBE Awards certificates are issued through London Business Consultancy and signed by an authorised
                  representative of the UK organiser. The certificate is an award-programme record; it is not a
                  certificate issued by the UK Government.
                </p>
                <p class="m-0 rounded-[14px] border-l-2 border-gbe-gold bg-gbe-gold/[0.06] px-5 py-4 text-sm font-medium leading-[1.68] text-gbe-text">
                  Authenticity comes from the match between the recipient, award title, category, year, authorised signature, and the organiser's published record.
                </p>
              </div>

              <div class="grid gap-4">
                {certificateAuthenticitySteps.map((step) => (
                  <article class="grid grid-cols-[64px_minmax(0,1fr)] gap-5 rounded-[16px] border border-gbe-gold/24 bg-gbe-card p-6 shadow-[var(--c-card-shadow)] max-[560px]:grid-cols-1 max-[560px]:gap-3">
                    <span class="gold-fill grid size-14 place-items-center rounded-full text-sm font-black text-black">{step.number}</span>
                    <div>
                      <h3 class="mb-2 mt-0 text-2xl font-black leading-tight text-gbe-text">{step.title}</h3>
                      <p class="m-0 text-[15px] font-normal leading-[1.68] text-gbe-muted">{step.text}</p>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </section>

        <section class="container-gbe mt-20 max-w-[1120px] max-[560px]:mt-14">
          <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-8 rounded-[20px] border border-gbe-gold/35 bg-[radial-gradient(circle_at_12%_20%,rgba(255,176,1,0.1),transparent_260px),var(--c-card)] p-8 shadow-[var(--c-card-shadow)] max-[760px]:grid-cols-1 max-[560px]:p-6">
            <div>
              <p class="mb-2 mt-0 text-xs font-black uppercase tracking-[0.19em] text-gbe-gold-soft">GBE Awards 2026</p>
              <h2 class="gold-text mb-3 mt-0 text-[clamp(25px,3vw,36px)] font-black leading-tight">Put a substantiated achievement forward</h2>
              <p class="m-0 max-w-[720px] text-[16px] font-normal leading-[1.7] text-gbe-muted">
                Choose the category that best reflects the work and provide clear information the organiser can review.
              </p>
            </div>
            <a class="btn-gold btn-gold-hover" href="https://access.gbeaward.com/apply" target="_blank" rel="noopener noreferrer">Apply now</a>
          </div>
        </section>
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
