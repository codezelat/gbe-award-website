    .wie-hero p,
    .wie-hero a {
      animation: wie-rise 720ms cubic-bezier(0.2, 0.75, 0.2, 1) both;
    }

    .wie-hero h1 { animation-delay: 80ms; }
    .wie-hero p:not(:first-child) { animation-delay: 150ms; }
    .wie-hero a { animation-delay: 220ms; }
