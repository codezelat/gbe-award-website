---
interface Props {
  class?: string;
  maskId?: string;
}

const {
  class: className = "footer-organiser-logo",
  maskId = "lbc-footer-logo-mask",
} = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 6636 1868"
  role="img"
  aria-labelledby={`${maskId}-title`}
>
  <title id={`${maskId}-title`}>London Business Consultancy</title>
  <defs>
    <mask id={maskId} maskUnits="userSpaceOnUse" x="0" y="0" width="6636" height="1868">
      <image
        href="/assets/brand/london-business-consultancy-logo-mask.webp"
        x="0"
        y="0"
        width="6636"
        height="1868"
        preserveAspectRatio="xMidYMid meet"
      />
    </mask>
  </defs>
  <rect width="6636" height="1868" fill="currentColor" mask={`url(#${maskId})`} />
</svg>
