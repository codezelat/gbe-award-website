---
import { SITE_GOOGLE_TAG_ID } from "../lib/site";

const googleTagId = SITE_GOOGLE_TAG_ID;
const googleTagSrc = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(googleTagId)}`;
---

<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<script is:inline async src={googleTagSrc} data-google-tag-id={googleTagId}></script>
<script is:inline define:vars={{ googleTagId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}
  window.gtag = window.gtag || gtag;
  window.gtag('js', new Date());
  window.gtag('config', googleTagId);
</script>
