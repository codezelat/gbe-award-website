---
import { bestWebsiteAwardsFeature } from "../data/home";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const titleId = compact ? "best-website-awards-contact-title" : "best-website-awards-home-title";
---

<section
  class:list={[
    "bg-gbe-bg",
    compact ? "mb-16 max-[560px]:mb-10" : "py-12 max-[560px]:py-9",
  ]}
  aria-labelledby={titleId}
>
  <div class:list={["container-gbe", compact && "max-w-[1120px]"]}>
    <div
      class:list={[
        "group grid items-center overflow-hidden rounded-[18px] border border-white/[0.09] bg-[var(--c-card)] p-3 shadow-[0_18px_46px_rgba(0,0,0,0.18)] transition-[border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-gbe-gold/35",
        compact
          ? "grid-cols-[88px_minmax(0,1fr)_auto] gap-5 max-[680px]:grid-cols-[76px_minmax(0,1fr)] max-[680px]:gap-4"
          : "grid-cols-[132px_minmax(0,1fr)_auto] gap-7 max-[680px]:grid-cols-[88px_minmax(0,1fr)] max-[680px]:gap-4",
      ]}
    >
      <a
        class:list={[
          "block overflow-hidden rounded-[12px] bg-black",
          compact ? "aspect-square" : "aspect-[4/3] max-[680px]:aspect-square",
        ]}
        href={bestWebsiteAwardsFeature.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Explore Best Website Awards 2026"
      >
        <img
          class="size-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
          src={bestWebsiteAwardsFeature.image}
          alt="Web design studio workspace"
          width="720"
          height="540"
          loading="lazy"
          decoding="async"
        />
      </a>

      <div class="min-w-0 py-2">
        <div class="mb-2 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.18em] text-gbe-gold-soft">
            <span class="size-1.5 rounded-full bg-gbe-gold shadow-[0_0_9px_rgba(216,179,86,0.55)]" aria-hidden="true"></span>
            {bestWebsiteAwardsFeature.status}
          </span>
          <span class="text-[10px] font-medium uppercase tracking-[0.14em] text-gbe-muted">Powered by GBE Awards</span>
        </div>

        <h2
          id={titleId}
          class:list={[
            "m-0 font-black leading-[1.08] tracking-[-0.025em] text-gbe-text",
            compact ? "text-[clamp(22px,2.4vw,30px)]" : "text-[clamp(24px,3vw,34px)]",
          ]}
        >
          Best Website Awards <span class="text-gbe-gold-soft">2026</span>
        </h2>
      </div>

      <a
        class="mr-3 inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-gbe-gold/35 px-5 py-2.5 text-[11px] font-black uppercase tracking-[0.14em] text-gbe-gold-soft transition-colors hover:border-gbe-gold hover:bg-gbe-gold hover:text-black max-[680px]:col-span-2 max-[680px]:mr-0 max-[680px]:justify-center"
        href={bestWebsiteAwardsFeature.applyUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Apply
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
