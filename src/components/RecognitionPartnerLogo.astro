---
import type { RecognitionPartner } from "../data/recognition";
import LondonBusinessConsultancyLogo from "./LondonBusinessConsultancyLogo.astro";

interface Props {
  partner: RecognitionPartner;
  compact?: boolean;
  maskId?: string;
}

const { partner, compact = false, maskId = `lbc-${partner.key}-logo-mask` } = Astro.props;
---

<div
  class:list={[
    "grid shrink-0 place-items-center rounded-[16px] border border-black/10 bg-[#f8f7f3] p-4 shadow-[0_10px_30px_rgba(0,0,0,0.18)]",
    compact ? "h-[92px] w-full" : "h-[116px] w-[220px] max-[560px]:h-[100px] max-[560px]:w-full",
  ]}
>
  {partner.key === "lbc" ? (
    <LondonBusinessConsultancyLogo
      class="h-auto max-h-[58px] w-full max-w-[190px] text-[#121d33]"
      maskId={maskId}
    />
  ) : (
    <img
      class:list={[
        "h-full w-full object-contain",
        partner.key === "dec" ? "max-h-[78px]" : "max-h-[70px]",
      ]}
      src={partner.logo}
      srcset={partner.logoSmall ? `${partner.logoSmall} 400w, ${partner.logo} 720w` : undefined}
      sizes={compact ? "190px" : "(max-width: 560px) 320px, 190px"}
      alt={partner.logoAlt}
      width="720"
      height={partner.key === "dec" ? 325 : 344}
      loading="lazy"
      decoding="async"
    />
  )}
</div>
