---
import { certificateAuthenticitySteps, recognitionPartners } from "../data/recognition";
import RecognitionCountryMarks from "./RecognitionCountryMarks.astro";
import RecognitionPartnerLogo from "./RecognitionPartnerLogo.astro";
import RecognitionRoleIcon from "./RecognitionRoleIcon.astro";
---

<section
  id="recognition"
  class="relative overflow-hidden border-y border-gbe-gold/15 bg-gbe-surface-2 py-24 max-[1024px]:py-[72px] max-[560px]:py-14"
  aria-labelledby="recognition-home-title"
>
  <div class="mandala pointer-events-none absolute -left-28 top-6 size-[460px] opacity-40" aria-hidden="true"></div>
  <div class="mandala pointer-events-none absolute -bottom-48 right-[-120px] size-[520px] opacity-25" aria-hidden="true"></div>

  <div class="container-gbe relative">
    <div class="grid grid-cols-[0.78fr_1.22fr] gap-20 max-[1024px]:grid-cols-1 max-[1024px]:gap-12">
      <div class="max-w-[470px] max-[1024px]:max-w-[720px]">
        <h2 id="recognition-home-title" class="gold-text mb-6 mt-0 text-[clamp(38px,5vw,64px)] font-black leading-[0.98]">
          Recognition with substance
        </h2>
        <p class="mb-4 mt-0 text-[clamp(16px,1.3vw,19px)] font-normal leading-[1.72] text-gbe-muted">
          The GBE Awards programme is <strong class="font-black text-gbe-gold">institutionally recognised in Sri Lanka through DEC</strong>.
        </p>
        <p class="mb-6 mt-0 rounded-r-[12px] border-l-2 border-gbe-gold bg-gbe-gold/[0.07] px-4 py-3 text-[15px] font-medium leading-[1.6] text-gbe-text">
          DEC is identified under Sri Lanka's <strong class="font-black text-gbe-gold-bright">Ministry of Industry</strong>.
        </p>
        <RecognitionCountryMarks compact />
        <a
          class="mt-7 inline-flex items-center gap-2 text-sm font-black uppercase tracking-[0.13em] text-gbe-gold underline decoration-gbe-gold/45 underline-offset-[6px] transition-colors hover:text-gbe-gold-bright"
          href="/recognition"
        >
          Explore recognition
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="border-t border-gbe-gold/25">
        {recognitionPartners.map((partner, index) => (
          <article class="grid grid-cols-[minmax(0,1fr)_220px] items-center gap-8 border-b border-gbe-gold/20 py-7 max-[760px]:grid-cols-1 max-[760px]:gap-5">
            <div class="flex gap-4">
              <RecognitionRoleIcon type={partner.key} />
              <div>
                <p class="mb-1 mt-0 text-[11px] font-black uppercase tracking-[0.18em] text-gbe-gold-soft">{partner.eyebrow}</p>
                <h3 class="mb-2 mt-0 text-[clamp(20px,2vw,27px)] font-black leading-tight text-gbe-text">{partner.name}</h3>
                <p class="m-0 max-w-[620px] text-[15px] font-normal leading-[1.65] text-gbe-muted">{partner.summary}</p>
              </div>
            </div>
            <RecognitionPartnerLogo partner={partner} maskId={`lbc-home-${index}-mask`} />
          </article>
        ))}
      </div>
    </div>

    <div class="mt-14 grid grid-cols-[0.34fr_1fr] overflow-hidden rounded-[20px] border border-gbe-gold/35 bg-[radial-gradient(circle_at_10%_15%,rgba(255,176,1,0.12),transparent_250px),var(--c-card)] shadow-[var(--c-card-shadow)] max-[900px]:grid-cols-1">
      <div class="flex flex-col justify-center border-r border-gbe-gold/20 p-8 max-[900px]:border-b max-[900px]:border-r-0 max-[560px]:p-6">
        <p class="mb-2 mt-0 text-xs font-black uppercase tracking-[0.2em] text-gbe-gold-soft">Award certificates</p>
        <p class="m-0 text-[15px] font-normal leading-[1.7] text-gbe-muted">
          Every certificate should connect back to a named recipient, award record, year, and authorised UK organiser.
        </p>
      </div>
      <div class="grid grid-cols-3 divide-x divide-gbe-gold/20 max-[760px]:grid-cols-1 max-[760px]:divide-x-0 max-[760px]:divide-y">
        {certificateAuthenticitySteps.map((step) => (
          <div class="p-7 max-[560px]:p-6">
            <span class="gold-text text-sm font-black">{step.number}</span>
            <h4 class="mb-2 mt-3 text-xl font-black text-gbe-text">{step.title}</h4>
            <p class="m-0 text-sm font-normal leading-[1.65] text-gbe-muted">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
